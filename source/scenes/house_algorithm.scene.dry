title: House Election
on-arrival: {!

Q.rep_r_pro = 0;
Q.dem_r_pro = 0;
Q.other_r_pro = 0;

let repVotes = 0;
let demVotes = 0;
let otherVotes = 0;

for (let state of Q.states) {
  for (let cls of Q.classes) {
    let pop = Q[state + "_" + cls] || 0;

    let stateRes = Q[("resistance_factor_" + state) * (("resistance_factor_" + state)/105) +0.90)];

    // support
    let rep = Q[(cls + "_gop") * pop] || 0;
    let dem = Q[(cls + "_dem") * pop] || 0;

    let adjDem = dem/stateRes;
    let adjRep = rep;

    let totalPct = adjRep + adjDem;

    repVotes += pop * (adjRep / totalPct);
    demVotes += pop * (adjDem / totalPct);
  }
}

// Allocate projected seats
let totalVotes = repVotes + demVotes + otherVotes;
let totalSeats = Q.total_house_seats || 241;

let repShare = repVotes / totalVotes;
let demShare = demVotes / totalVotes;

Q.rep_r_pro = Math.floor(repShare * totalSeats);
Q.dem_r_pro = Math.floor(demShare * totalSeats);

console.log(rep_r, dem_r)

!}
go-to: jumpScene
